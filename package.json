{
  "name": "@swors/data-table",
  "version": "0.0.0",
  "description": "Vue 3 için DataTable, DocumentTable ve DataSheet: ortak çekirdek, üç bileşen.",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sheet": {
      "types": "./dist/sheet.d.ts",
      "import": "./dist/sheet.js"
    },
    "./style.css": "./dist/style.css",
    "./shadcn-bridge.css": "./dist/shadcn-bridge.css",
    "./shadcn-bridge-hsl.css": "./dist/shadcn-bridge-hsl.css"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:docs": "node --experimental-strip-types scripts/tokens-from-docs.ts && node --experimental-strip-types scripts/i18n-from-docs.ts",
    "check": "node --experimental-strip-types scripts/tokens-from-docs.ts && node --experimental-strip-types scripts/i18n-from-docs.ts && vue-tsc --noEmit -p tsconfig.json && eslint . && prettier --check . && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "reka-ui": "^2.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "reka-ui": "^2.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "@tanstack/vue-table": "^9.3.1",
    "@tanstack/vue-virtual": "^3.13.47"
  }
}
